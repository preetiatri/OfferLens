# Ensure these are always treated as binary and never subject to line-ending
# conversion (CRLF<->LF) on checkout, regardless of platform or core.autocrlf.
# Without this, a binary file's bytes can get silently corrupted when checked
# out on a different OS than it was committed from - this is what broke the
# Gradle wrapper on GitHub Actions' Linux runners (see deploy.yml failures).
*.jar -text -diff binary
*.png -text -diff binary
*.jpg -text -diff binary
*.jpeg -text -diff binary
*.webp -text -diff binary
*.ico -text -diff binary
*.ttf -text -diff binary
*.otf -text -diff binary
*.keystore binary
*.jks binary
